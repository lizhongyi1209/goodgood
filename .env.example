# The UI build requires no runtime secrets. M3 durable generation uses these
# names through Compose defaults or a local ignored environment file.
# Names only belong here—never real values.
#
# Optional process and health-check overrides:
# HOST=
# PORT=
# WORKER_HEALTH_HOST=
# WORKER_HEALTH_PORT=
# MOCK_GENERATION_HOST=
# MOCK_GENERATION_PORT=
# GOODGOOD_PROCESS=
# GOODGOOD_REVISION=
# GOODGOOD_IMAGE_TAG=
# GOODGOOD_WEB_PORT=
# GOODGOOD_WORKER_HEALTH_PORT=
# GOODGOOD_MOCK_GENERATION_PORT=
# GOODGOOD_POSTGRES_PORT=
# GOODGOOD_VALKEY_PORT=
# GOODGOOD_OBJECT_STORAGE_PORT=
# GOODGOOD_OBJECT_STORAGE_CONSOLE_PORT=
# GOODGOOD_LOCAL_POSTGRES_PASSWORD=
# GOODGOOD_LOCAL_OBJECT_STORAGE_ACCESS_KEY=
# GOODGOOD_LOCAL_OBJECT_STORAGE_SECRET_KEY=
# GOODGOOD_LOCAL_GENERATION_API_KEY=
#
# DATABASE_URL=
# REDIS_URL=
# OBJECT_STORAGE_ENDPOINT=
# OBJECT_STORAGE_PUBLIC_ENDPOINT=
# OBJECT_STORAGE_BUCKET=
# OBJECT_STORAGE_REGION=
# OBJECT_STORAGE_ACCESS_KEY_ID=
# OBJECT_STORAGE_SECRET_ACCESS_KEY=
# OBJECT_STORAGE_FORCE_PATH_STYLE=
# GENERATION_API_BASE_URL=
# GENERATION_API_KEY=
# GENERATION_POLL_INTERVAL_MS=
# GENERATION_POLL_TIMEOUT_MS=
# GENERATION_WORKER_LEASE_MS=
