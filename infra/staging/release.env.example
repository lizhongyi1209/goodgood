# Copy outside the repository, replace every placeholder from one successful CI
# summary, and chmod 600 on Linux. This file contains release identity and host
# paths only; it must not contain credentials.
GOODGOOD_RELEASE_IMAGE=ghcr.io/lizhongyi1209/goodgood@sha256:REPLACE_WITH_64_HEX_DIGEST
GOODGOOD_RELEASE_REVISION=REPLACE_WITH_40_HEX_GIT_SHA
GOODGOOD_RELEASE_MIGRATION=REPLACE_WITH_CI_MIGRATION_FILENAME
GOODGOOD_RUNTIME_CONFIG_VERSION=REPLACE_WITH_64_HEX_CONFIG_CHECKSUM
GOODGOOD_RUNTIME_ENV_FILE=/etc/goodgood/staging/runtime.env
GOODGOOD_AUTH_CLIENT_SECRET_SOURCE_FILE=/etc/goodgood/staging/secrets/auth-client-secret
GOODGOOD_GENERATION_API_KEY_SOURCE_FILE=/etc/goodgood/staging/secrets/o1key-api-key
GOODGOOD_OBJECT_STORAGE_ACCESS_KEY_ID_SOURCE_FILE=/etc/goodgood/staging/secrets/r2-access-key-id
GOODGOOD_OBJECT_STORAGE_SECRET_ACCESS_KEY_SOURCE_FILE=/etc/goodgood/staging/secrets/r2-secret-access-key
GOODGOOD_STAGING_WEB_PORT=3000
GOODGOOD_STAGING_WORKER_HEALTH_PORT=3001
