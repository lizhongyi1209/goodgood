# Install as /etc/goodgood/staging/secrets/backups/msmtp.conf and chmod
# root:root 0600. Replace every placeholder with the dedicated alert sender's
# authenticated SMTP submission settings. Never reuse an application secret.
defaults
auth on
tls on
tls_starttls on
tls_trust_file /etc/ssl/certs/ca-certificates.crt
timeout 15

account staging-alert
host REPLACE_WITH_SMTP_HOST
port 587
from REPLACE_WITH_SENDER_EMAIL
user REPLACE_WITH_SMTP_USERNAME
password REPLACE_WITH_SMTP_PASSWORD

account default : staging-alert
