# Copy outside the repository, replace every remaining placeholder, and chmod
# 600 on Linux. R2 credentials belong only in the release-file referenced
# secret files, never inline here.
NODE_ENV=production

DATABASE_URL=postgresql://goodgood:REPLACE_ME@replace-postgres:5432/goodgood
REDIS_URL=redis://replace-valkey:6379

OBJECT_STORAGE_PROVIDER_KIND=r2
OBJECT_STORAGE_ENDPOINT=https://3b918f80852289d9879e7f73bccc2e22.r2.cloudflarestorage.com
OBJECT_STORAGE_PUBLIC_ENDPOINT=https://3b918f80852289d9879e7f73bccc2e22.r2.cloudflarestorage.com
OBJECT_STORAGE_BUCKET=goodgood
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_PROVISIONING_MODE=verify
OBJECT_STORAGE_ACCESS_KEY_ID_FILE=/run/secrets/goodgood_object_storage_access_key_id
OBJECT_STORAGE_SECRET_ACCESS_KEY_FILE=/run/secrets/goodgood_object_storage_secret_access_key
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_UPLOAD_ALLOWED_ORIGINS=https://goodgood.o1key.com

GOODGOOD_ALLOW_LOCAL_AUTH=false
GOODGOOD_AUTH_MODE=oidc
GOODGOOD_AUTH_ISSUER=https://replace.authing.cn/oidc
GOODGOOD_AUTH_CLIENT_ID=REPLACE_ME
GOODGOOD_AUTH_CLIENT_SECRET_FILE=/run/secrets/goodgood_auth_client_secret
GOODGOOD_AUTH_REDIRECT_URI=https://goodgood.o1key.com/api/auth/callback
GOODGOOD_AUTH_COOKIE_NAME=__Host-goodgood_session
GOODGOOD_AUTH_COOKIE_SECURE=true

GENERATION_PROVIDER_KIND=o1key
GENERATION_API_BASE_URL=https://cf-api.o1key.com
GENERATION_API_KEY_FILE=/run/secrets/goodgood_generation_api_key
GENERATION_PROVIDER_ALLOW_INSECURE_LOOPBACK=false
GENERATION_POLL_INTERVAL_MS=1000
GENERATION_POLL_TIMEOUT_MS=180000
GENERATION_REQUEST_TIMEOUT_MS=30000
GENERATION_WORKER_LEASE_MS=15000

GOODGOOD_FAKE_PAYMENT_ENABLED=false
