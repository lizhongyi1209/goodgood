# Install as /etc/goodgood/production/postgres-backup.env, replace the account
# ID placeholder, and chmod root:root 0600. Credentials never belong here.
RESTIC_REPOSITORY=s3:https://REPLACE_WITH_32_HEX_ACCOUNT_ID.r2.cloudflarestorage.com/goodgood-postgres-backups/production
RESTIC_PASSWORD_FILE=/etc/goodgood/production/secrets/backups/restic-password
GOODGOOD_BACKUP_R2_ACCESS_KEY_ID_FILE=/etc/goodgood/production/secrets/backups/r2-access-key-id
GOODGOOD_BACKUP_R2_SECRET_ACCESS_KEY_FILE=/etc/goodgood/production/secrets/backups/r2-secret-access-key
