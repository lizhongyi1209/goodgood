# Copy outside the repository, replace every placeholder from one successful CI
# summary, and install as root:root 0600 on the Linux production host. This file
# contains release identity and host paths only; never put credentials in it.
GOODGOOD_RELEASE_IMAGE=ghcr.io/lizhongyi1209/goodgood@sha256:REPLACE_WITH_64_HEX_DIGEST
GOODGOOD_RELEASE_REVISION=REPLACE_WITH_40_HEX_GIT_SHA
GOODGOOD_RELEASE_MIGRATION=REPLACE_WITH_CI_MIGRATION_FILENAME
GOODGOOD_RUNTIME_CONFIG_VERSION=REPLACE_WITH_64_HEX_CONFIG_CHECKSUM
GOODGOOD_RUNTIME_ENV_FILE=/etc/goodgood/production/runtime.env
GOODGOOD_R2_INVENTORY_ENV_FILE=/etc/goodgood/production/r2-inventory.env
GOODGOOD_PRODUCTION_ORIGIN=https://goodgood.o1key.com
GOODGOOD_AUTH_CLIENT_SECRET_SOURCE_FILE=/etc/goodgood/production/secrets/auth-client-secret
GOODGOOD_GENERATION_API_KEY_SOURCE_FILE=/etc/goodgood/production/secrets/o1key-api-key
GOODGOOD_OBJECT_STORAGE_ACCESS_KEY_ID_SOURCE_FILE=/etc/goodgood/production/secrets/r2-access-key-id
GOODGOOD_OBJECT_STORAGE_SECRET_ACCESS_KEY_SOURCE_FILE=/etc/goodgood/production/secrets/r2-secret-access-key
GOODGOOD_PRODUCTION_SECRET_GID=REPLACE_WITH_NUMERIC_SECRET_GID
