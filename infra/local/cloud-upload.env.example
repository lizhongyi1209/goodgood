# Copy outside every GoodGood repository/worktree and set absolute *_FILE paths.
# Local Web accepts exactly these six keys with --cloud-env-file.
GOODGOOD_LOCAL_CLOUD_UPLOAD_BUCKET=o1key-goodgood
GOODGOOD_LOCAL_CLOUD_UPLOAD_REGION=cn-guangzhou
GOODGOOD_LOCAL_CLOUD_UPLOAD_ENDPOINT=https://oss-cn-guangzhou.aliyuncs.com
GOODGOOD_LOCAL_CLOUD_UPLOAD_PUBLIC_ENDPOINT=https://upload-goodgood.o1key.cn
GOODGOOD_LOCAL_CLOUD_UPLOAD_ACCESS_KEY_ID_FILE=C:\path\outside\repo\oss-access-key-id
GOODGOOD_LOCAL_CLOUD_UPLOAD_SECRET_ACCESS_KEY_FILE=C:\path\outside\repo\oss-secret-access-key
