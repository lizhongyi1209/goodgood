# Copy outside every GoodGood repository/worktree. The password file is separate.
# Use an authorized SMTP account and sender. Keep the existing local database.
GOODGOOD_EMAIL_FROM=GoodGood <no-reply@mail.goodgood.o1key.com>
GOODGOOD_EMAIL_SMTP_HOST=smtpdm-ap-southeast-1.aliyuncs.com
GOODGOOD_EMAIL_SMTP_PORT=465
GOODGOOD_EMAIL_SMTP_SECURE=true
GOODGOOD_EMAIL_SMTP_USERNAME=no-reply@mail.goodgood.o1key.com
GOODGOOD_EMAIL_SMTP_PASSWORD_FILE=C:\path\outside\repo\email-smtp-password
