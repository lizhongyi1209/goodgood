{
  "name": "goodgood",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "dev:local": "vite",
    "dev:workspace": "node scripts/local-live-dev.mjs",
    "build": "bash scripts/build-verified.sh",
    "build:local": "vinext build",
    "build:checkpoint": "node scripts/local-checkpoint.mjs build",
    "verify:checkpoint": "node scripts/local-checkpoint.mjs verify",
    "start:checkpoint": "node scripts/local-checkpoint.mjs start",
    "build:runtime": "node scripts/build-runtime.mjs",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "start:web": "node server/runtime/web.mjs",
    "start:worker": "node server/runtime/worker.mjs",
    "start:mock-generation": "node server/runtime/mock-generation.mjs",
    "stack:config": "node scripts/run-local-stack.mjs config",
    "stack:up": "node scripts/run-local-stack.mjs up",
    "stack:verify": "node infra/container/verify-compose.mjs",
    "stack:down": "node scripts/run-local-stack.mjs down",
    "stack:mock-test:config": "docker compose --project-name goodgood-mock-tests --profile mock-tests config --quiet",
    "stack:mock-test:up": "docker compose --project-name goodgood-mock-tests --profile mock-tests up --build --detach --wait",
    "stack:mock-test:verify": "node infra/container/verify-compose.mjs --include-mock",
    "stack:mock-test:down": "docker compose --project-name goodgood-mock-tests --profile mock-tests down",
    "stack:authing-local": "node scripts/run-authing-local.mjs",
    "stack:email-local": "node scripts/run-email-otp-local.mjs",
    "stack:email-local:down": "node scripts/run-email-otp-local.mjs --down",
    "stack:email-smtp-local": "node scripts/run-email-otp-smtp-local.mjs",
    "stack:o1key-local": "node scripts/run-o1key-local.mjs",
    "video:provider-smoke": "node scripts/run-seedance-provider-smoke.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:local": "npm run build:local && node --test tests/*.test.mjs",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "lint:local": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "ui:ai:add": "node scripts/add-ai-element.mjs",
    "typecheck": "tsc --noEmit --pretty false --incremental false",
    "check:local": "npm run lint:local && npm run typecheck && npm run test:local",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node server/runtime/migrate.mjs",
    "billing:manual-payment": "node server/runtime/manual-payment.mjs",
    "accounts:bootstrap-site-owner": "node server/runtime/bootstrap-site-owner.mjs",
    "references:cleanup": "node server/runtime/reference-cleanup.mjs",
    "auth:preflight": "node scripts/verify-authentication.mjs",
    "auth:cleanup": "node server/runtime/email-auth-cleanup.mjs",
    "auth:bind-existing": "node server/runtime/bind-existing-owner-emails.mjs",
    "auth:status": "node server/runtime/email-auth-status.mjs",
    "staging:preflight": "node scripts/verify-staging.mjs",
    "staging:release": "node scripts/run-staging-release.mjs",
    "production:preflight": "node scripts/verify-production-preflight.mjs",
    "production:artifact-evidence": "node scripts/import-artifact-security-evidence.mjs",
    "production:alpha-gate": "node scripts/verify-controlled-alpha-readiness.mjs",
    "production:gate": "node scripts/verify-production-readiness.mjs",
    "production:seed-gate": "node scripts/verify-seed-production-readiness.mjs",
    "production:conversion-plan": "node scripts/run-production-conversion.mjs",
    "production:r2-deletion-plan": "node scripts/run-production-r2-deletion-plan.mjs",
    "production:work-package": "node scripts/run-production-work-package.mjs",
    "production:release-plan": "node scripts/run-production-release.mjs",
    "production:seed-release-plan": "node scripts/run-seed-production-release.mjs",
    "test:m3": "node --test tests/m3-*.test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@aws-sdk/s3-request-presigner": "^3.1121.0",
    "@base-ui/react": "^1.7.0",
    "@emoji-mart/data": "1.2.1",
    "@hookform/resolvers": "^5.7.1",
    "@lobehub/icons": "^5.21.0",
    "@lobehub/icons-static-svg": "1.94.0",
    "@shadcn/react": "^0.3.0",
    "@tiptap/core": "3.31.4",
    "@tiptap/markdown": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "emoji-mart": "5.6.0",
    "input-otp": "^1.4.2",
    "jose": "6.2.10",
    "lucide-react": "^1.31.0",
    "motion": "^13.4.4",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "nodemailer": "10.0.6",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "react-wrap-balancer": "^1.1.1",
    "recharts": "^3.8.0",
    "redis": "^6.2.1",
    "sharp": "0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "ai-elements": "^1.9.0",
    "drizzle-kit": "0.31.10",
    "esbuild": "^0.28.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.9",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "fast-uri": "3.1.7",
    "nanoid": "3.3.18",
    "postcss": "8.5.28",
    "sharp": "$sharp",
    "source-map-js": "1.2.2"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "1.0.1"
  },
  "type": "module",
  "displayName": "GoodGood"
}
